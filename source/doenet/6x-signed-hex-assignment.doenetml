       <textInput name="D16lsw_Resp" forAnswer="$CDSumResponse"  width="15"><shortDescription>Q6 Addend digit 0</shortDescription></textInput>
  <m>_{16} =</m>
        <textInput name="CDSum1_Resp" forAnswer="$CDSumResponse"  width="15"><shortDescription>Q6 Sum digit 1</shortDescription></textInput>
       <textInput name="CDSum0_Resp" forAnswer="$CDSumResponse"  width="15"><shortDescription>Q6 Sum digit 0</shortDescription></textInput> <m>_{16}</m>
      </p>

  <setup>
  <!-- Interpret the hex codes entered -->
<p><integer name="D16mswDecimal"> 
    <module copy="$hexLookup" input="$D16msw_Resp.characters[2]"/> +
    (<module copy="$hexLookup" input="$D16msw_Resp.characters[1]"/> * $Base)</integer>:
<integer name="D16lswDecimal">
  <module copy="$hexLookup" input="$D16lsw_Resp.characters[2]"/> + 

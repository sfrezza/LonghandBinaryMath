  <module copy="$hexLookup" input="$CDSum1_Resp.characters[2]"/> + (<module copy="$hexLookup" input="$CDSum1_Resp.characters[1]"/> * 16)
  </integer>:
<integer name="CDSumLSWdecimal"> 
  <module copy="$hexLookup" input="$CDSum0_Resp.characters[2]"/> + (<module copy="$hexLookup" input="$CDSum0_Resp.characters[1]"/> * $Base)
  </integer> </p>
    </setup>
<setup>
  <p>Carry<m>_7</m>: <integer name="CDLSWCarry"><floor>($C16_lsw + $D16lswDecimal)/($Base^2)</floor></integer>
    and Carry<m>_{15}</m>: <integer name="CDMSWCarry"><floor>($C16_msw + $D16mswDecimal)/($Base^2)</floor></integer> 
   Overflow = <boolean name="CDOverflow16"><or>
  <and><not><xor>$Csign $Dsign</xor></not> $CDsign </and> </or></boolean>
  </p>
 </setup> 
  
<!-- See if the four words entered sum correctly -->
  <setup> 
<p> LSW Sum: ($C16_lsw + $D16lswDecimal - ($CDLSWCarry*$Base^2)) = $CDSumLSWdecimal : 
  <boolean name="CDLSWSumCorrect"><integer>($C16_lsw + $D16lswDecimal - $CDLSWCarry*$Base^2)</integer> = $CDSumLSWdecimal</boolean></p>

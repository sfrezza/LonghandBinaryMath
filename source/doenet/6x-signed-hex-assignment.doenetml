 <p><boolean name="Csign">($C16_msw > (8*$Base -1))</boolean>
    <boolean name="Dsign">($D16mswDecimal > (8*$Base -1))</boolean>
    <boolean name="CDsign"><integer>($C16_msw + $D16mswDecimal + $CDLSWCarry- ($CDMSWCarry * $Base^2))</integer> > <integer>(8*$Base -1)</integer></boolean>
 </p> 
<p>Carry and Overflow Correct: <boolean name="CDCarryOverflowCorrect"><and>$CDOverflow16 <boolean>$CDLSWCarry = 1</boolean></and>
</boolean></p>

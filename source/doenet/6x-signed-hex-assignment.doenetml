    <award name="CDSumCorrect" credit="1/2" matchBlanks="false">
      <when><and><not>$CDCarryOverflowCorrect</not> $CDMSWSumCorrect $CDLSWSumCorrect </and>
      </when></award>
        <award name="CDFlagBitsCorrect" credit="1/2" matchBlanks="false">
      <when><and>$CDCarryOverflowCorrect <or>
        <and><not>$CDMSWSumCorrect</not>$CDLSWSumCorrect </and>
        <and>     $CDMSWSumCorrect <not>$CDLSWSumCorrect </not> </and>
        </or></and>
      </when></award>
  </answer>


<setup>
  <p><integer name="CorrectCDMSW">($C16_msw + $D16mswDecimal + $CDLSWCarry) </integer> ...
